# ============================================================
# 环境变量说明（本文件即**完整清单**，不另设 docs 文档）
#   · 本地开发：复制为 `.env.local`（.gitignore 已排除 `.env*`）
#   · 线上部署：填进 Vercel 项目的 Environment Variables
#
# ⚠️ 本文件被 `.gitignore` 的 `!.env.example` **显式反排除**，也就是设计上会进版本库。
#    因此这里只放占位符，绝不要写入真实凭据 —— 真值只放 `.env.local` 和 Vercel 环境变量。
#
# ⚠️ 这里**只有基础设施凭据**。站点自身的全部设置（网站地址、标题、图床、
#    音乐 API、主题…）一律在「后台 → 站点配置」里填，代码里没有对应的环境变量兜底。
#
# 本文件分两段：
#   必填段 —— 不带 `#` 前缀，Vercel 导入项目时会自动预填成变量（共 3 个）。
#   可选段 —— 一律**以 `#` 开头**，只是给你看的说明；需要时手工去掉 `#` 再填。
# ============================================================


# ============ 必填（3 个）============

# ★ DATABASE_URL：应用运行时 + 构建都靠它（Prisma Client 唯一依赖的连接串）。
#   请用 Supabase **Transaction pooler（事务池，端口 6543）**：
#   serverless（Vercel 等）下多个函数实例 × 每实例连接池会抢占连接，
#   事务池由 Supavisor 把客户端连接复用为少量后端连接，不会打满 Postgres 连接上限。
#   Session pooler / 直连（5432）由多实例叠加后极易耗尽连接 → 全站间歇性无响应。
#   追加 ?pgbouncer=true 关闭服务端 prepared statement（事务池不支持）。
#   注意：密码中的特殊字符需要 URL 编码（如 @ 写为 %40）。
DATABASE_URL=postgresql://postgres.<项目ref>:<数据库密码>@aws-0-<区域>.pooler.supabase.com:6543/postgres?pgbouncer=true

# ★ Supabase Auth（登录身份体系）
#   控制台路径：Project Settings → API
#     SUPABASE_URL        项目地址，完整 URL 如 https://<项目ref>.supabase.co
#     SUPABASE_ANON_KEY   anon / publishable（公开）key
#                         它本身会下发到浏览器，不算机密；但绝不要在这里放
#                         service_role key（那是全权限密钥）。
#   缺失时登录/注册接口会直接抛「Supabase 未配置」。
SUPABASE_URL=https://<项目ref>.supabase.co
SUPABASE_ANON_KEY=<anon / publishable key>


# ============ 可选（按需放开 `#`）============

# 【DDL 直连串】Prisma CLI 执行迁移/seed 时需要能跑 DDL 的连接
# （事务池 6543 不支持 DDL）。**通常不需要填**：scripts/db-migrate.mjs 与
# prisma.config.ts 会自动把 DATABASE_URL 的 6543 降级为 5432，并按
# DIRECT_URL → DATABASE_URL → 5432 的顺序逐个探测，取第一个能连上的。
# 只有当你希望迁移走一条与运行时完全不同的独立直连串时才填。
#DIRECT_URL=postgresql://postgres.<项目ref>:<数据库密码>@db.<项目ref>.supabase.co:5432/postgres


# ============ 其余设置一律在后台完成 ============
#
# 以下这些**没有环境变量**，只在「后台 → 站点配置」里填（存 SiteConfig 表）：
#   网站地址（url）  生成 sitemap / robots / RSS / OG 绝对链接的基准。
#                    不填时按 site_config.url → Vercel 自动注入的域名 → 本地 127.0.0.1
#                    逐级解析（见 app/lib/site-url.ts）。绑定自定义域名后请务必填写，
#                    否则 canonical / OG / RSS 会指向 *.vercel.app。
#   图床（endpoint / bucket / accessKey / secretKey / region / imageCdnDomain）
#                    自建 S3 兼容对象存储（如 bitiful）的上传凭据与直链域名。
#                    留空 imageCdnDomain 则图片走 /api/img-proxy 同源代理。
#                    注意：CDN 直链域名不在 next/image 的构建期白名单里，
#                    配了它图片会降级为原生 <img>（能正常显示，只是少了尺寸/格式优化）。
#   音乐 API（cloudMusicApiUrl 等）
#
# 部署后需要做的事（**不需要手工跑迁移**）：
#   `pnpm build` 里带了 scripts/auto-migrate.mjs —— 部署时会自动建表/应用迁移：
#     · 全新空库  → 建全部表 + 灌站点配置默认值；
#     · 已是最新  → 秒级空转（幂等，可反复部署）；
#     · 连不上库  → **让构建失败**（而不是静默起一个没有表的站点）。
#   VERCEL_ENV=preview 的预览部署会跳过迁移，不动生产库。
# 所以首次部署完就能用。之后要做的只有：
#   1. 站点注册第一个账号  → 即成为管理员（无需任何环境变量）
#   2. 进后台「站点配置」把网站地址、标题、头像等改成自己的
#   3. 万一首个管理员被他人抢注：pnpm db:admin <你的邮箱>   # 夺回管理员
#      （等价的直接调用：node scripts/set-admin.mjs <你的邮箱>；
#        pnpm db:admin --list 可列出当前所有管理员）
